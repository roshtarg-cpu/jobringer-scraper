{
  "title": "JobRinger Scraper Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "searchQuery": {
      "type": "string",
      "title": "Job Title / Keywords",
      "description": "Search for specific job titles or keywords",
      "prefill": "software engineer",
      "editor": "textfield"
    },
    "location": {
      "type": "string",
      "title": "Location",
      "description": "City, state, or region to filter jobs",
      "prefill": "Mumbai",
      "editor": "textfield"
    },
    "jobType": {
      "type": "string",
      "title": "Employment Type",
      "description": "Filter by job type",
      "prefill": "Full-time",
      "editor": "select",
      "enum": ["Any", "Full-time", "Part-time", "Contract", "Remote", "Work from Home"],
      "enumTitles": ["Any Type", "Full-time", "Part-time", "Contract", "Remote", "Work from Home"]
    },
    "experienceLevel": {
      "type": "string",
      "title": "Experience Level",
      "description": "Filter by required experience",
      "prefill": "1-3 years",
      "editor": "select",
      "enum": ["Any", "Fresher", "0-1 years", "1-3 years", "3-5 years", "5-10 years", "10+ years"],
      "enumTitles": ["Any Experience", "Fresher", "0-1 years", "1-3 years", "3-5 years", "5-10 years", "10+ years"]
    },
    "salaryMin": {
      "type": "integer",
      "title": "Minimum Salary (INR per annum)",
      "description": "Minimum annual salary in Indian Rupees (optional)",
      "prefill": 500000,
      "editor": "number"
    },
    "includeDescription": {
      "type": "boolean",
      "title": "Include Full Descriptions",
      "description": "Extract complete job descriptions (slower but more detailed)",
      "prefill": true,
      "editor": "checkbox"
    },
    "maxResults": {
      "type": "integer",
      "title": "Max Results",
      "description": "Maximum number of jobs to scrape",
      "default": 50,
      "prefill": 10,
      "minimum": 1,
      "maximum": 500
    },
    "proxyConfiguration": {
      "type": "object",
      "title": "Proxy Configuration",
      "description": "Apify proxy settings for reliable scraping",
      "prefill": {
        "useApifyProxy": true,
        "apifyProxyGroups": ["RESIDENTIAL"]
      },
      "editor": "proxy"
    }
  },
  "required": ["maxResults"]
}
